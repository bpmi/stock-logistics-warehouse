<odoo>
    <record id="product_supplierinfo_view_tree_inherit_purchase_packaging" model="ir.ui.view">
        <field name="name">product.supplierinfo.tree.view" (purchase_packaging)</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="groups">product.group_product_variant, product.group_stock_packaging</attribute>
                <attribute name="string">Product/Variant</attribute>
            </xpath>
            <field name="min_qty" position="after">
                <field name="min_qty_uom_id" groups="product.group_uom"/>
                <field name="packaging_id" groups="product.group_stock_packaging"/>
            </field>
        </field>
    </record>

    <record id="product_supplierinfo_view_form_inherit_purchase_packaging" model="ir.ui.view">
        <field name="name">product.supplierinfo.form.view (purchase_packaging)</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_form_view"/>
        <field name="arch" type="xml">
            <!-- Members of the Manage Product Packaging group should see the product_id field -->
<!--            <field name="product_id" position="attributes">-->
<!--                <attribute name="groups" eval="append">-->
<!--                    product.group_stock_packaging-->
<!--                </attribute>-->
<!--            </field>-->
<!--            <field name="product_id" position="attributes">-->
<!--                <attribute name="groups" eval="[(4, ref('product.group_stock_packaging'))]"/>-->
<!--            </field>-->


<!--            <xpath expr="//field[@name='product_id']" position="attributes">-->
<!--                 <attribute name="groups" eval="append">-->
<!--                     product.group_stock_packaging-->
<!--                 </attribute>-->
<!--            </xpath>-->


<!--            <xpath expr="//field[@name='product_id']" position="attributes">-->
<!--                 <attribute name="groups" eval="[(4, ref('product.group_stock_packaging'))]"/>-->
<!--            </xpath>-->


            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="groups">product.group_product_variant, product.group_stock_packaging</attribute>
                <attribute name="string">Product/Variant</attribute>
            </xpath>

            <field name="min_qty" position="after">
                <span> x <field name="min_qty_uom_id" groups="product.group_uom"/></span>
            </field>
            <field name="product_uom" position="before">
                <span> of </span>
            </field>
            <field name="product_uom" position="after">
                <div attrs="{'invisible': [('product_id', '!=', False)]}" groups="product.group_stock_packaging">
                    <!--Product ID is empty. To select or create a Package, wWe need a Product ID and don't have it yet. -->
                    <p>Select a Product or Product Variant to display Packages</p>
                </div>
                <div attrs="{'invisible': [('product_id', '=', False)]}" groups="product.group_stock_packaging">
                    <!--Product ID is NOT empty — proceed to select a Package. -->
                    <span>using package </span>
                    <field name="packaging_id" domain="[('product_id', '=', product_id)]"
                           options='{"no_quick_create": True}'/>
                </div>
            </field>
<!--            <field name="delay" position="after">-->
<!--                <field name="product_tmpl_id" invisible="1" required="False"/>-->
<!--            </field>-->
        </field>
    </record>
</odoo>
